# ── Discord credentials ───────────────────────────────────────────────
# Both come from https://discord.com/developers/applications — see README
# ("Create the Discord app") for the exact clicks.
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=paste-your-application-id-here

# ── Optional ──────────────────────────────────────────────────────────
# Only needed if YouTube starts demanding a login for this server's IP
# (you'd see "Sign in to confirm you're not a bot" style errors in logs).
# 1. Export cookies from your browser (see README FAQ)
# 2. Put them in ./cookies.txt next to docker-compose.yaml
# 3. Uncomment the line in docker-compose.yaml that mounts it, then:
#YT_DLP_COOKIES=/app/cookies.txt

# Override where the yt-dlp binary lives (default: yt-dlp on PATH)
#YTDLP_PATH=yt-dlp
